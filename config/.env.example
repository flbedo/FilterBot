# ==============================================================================
# НАСТРОЙКИ TELEGRAM API
# Получите эти данные на https://my.telegram.org (раздел API development tools)
# ==============================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=ваш_хэш_здесь_длинная_строка_букв_и_цифр

# ==============================================================================
# НАСТРОЙКИ СЕССИИ
# TELEGRAM_SESSION — это ТОЛЬКО имя файла (без расширения .session),
# в котором будут сохранены ключи авторизации. При первом запуске программа
# сама создаст этот файл и попросит ввести номер телефона и код из Telegram.
# ==============================================================================
TELEGRAM_SESSION=filterbot_session

# ==============================================================================
# ИСТОЧНИКИ И ЦЕЛЬ
# TELEGRAM_SOURCES: ровно два источника (каналы/чаты) через запятую.
# Можно использовать @username или числовые ID (например, -1001234567890).
# TELEGRAM_TARGET: куда пересылать найденные сообщения (@username или ID).
# ==============================================================================
TELEGRAM_SOURCES=@news_channel_1, @news_channel_2
TELEGRAM_TARGET=@my_target_group

# ==============================================================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ (можно оставить по умолчанию)
# ==============================================================================
# Сколько последних сообщений проверить в тестовом режиме (history)
HISTORY_LIMIT=500

# Количество попыток переподключения при сетевых ошибках
NETWORK_RETRIES=5

# Базовая задержка между попытками переподключения (в секундах)
NETWORK_RETRY_BASE_SECONDS=3.0

# Лимит пограничных примеров, которые выводятся в тестовом режиме
BORDERLINE_LIMIT=10

# Проверять повторы текста (1 - включено, 0 - выключено)
CHECK_TEXT_REPEATS=0